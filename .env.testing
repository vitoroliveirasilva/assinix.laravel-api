APP_NAME=Assinix
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=4

LOG_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_API_MAX_ATTEMPTS=120

AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
AWESOMEAPI_API_KEY=
AWESOMEAPI_TIMEOUT=1
AWESOMEAPI_RETRY_TIMES=0
AWESOMEAPI_RETRY_SLEEP_MS=0
CURRENCY_RATE_CACHE_MINUTES=60

API_VERSION=1.0.0
SCRAMBLE_API_PATH=api/v1
SCRAMBLE_API_DOMAIN=